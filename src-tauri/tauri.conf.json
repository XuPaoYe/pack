{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Super AI",
  "version": "3.3.2",
  "identifier": "cn.talentisan.super-ai",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "npm exec vite -- --host 127.0.0.1",
    "beforeBuildCommand": "node scripts/app-build.mjs"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Super AI",
        "create": false,
        "width": 1320,
        "height": 740,
        "visible": false,
        "minWidth": 1320,
        "minHeight": 740,
        "maxWidth": 1320,
        "maxHeight": 740,
        "center": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 18
        },
        "transparent": false,
        "resizable": false,
        "maximizable": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: https://asset.localhost data: blob:; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "macOS": {
      "infoPlist": "Info.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/superai-api",
      "binaries/language_server"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJGNEIzOUI2OTdCMUEzQ0MKUldUTW83R1h0amxMdjMrOGVkeGlzRS9Pc1F4NkhVekVPSjc3V0swUjlGcFpaWkRsWTAvRk5ZRWwK",
      "endpoints": [
        "https://ai.talentisan.cn/SuperAI/latest.json"
      ]
    }
  }
}
